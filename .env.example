# NEXUS LOGISTICS OS — variables de entorno (copiar a .env). NUNCA commitear valores reales.

# Conexión de migraciones (dueño de las tablas). Solo la usa database/migrate.mjs.
DATABASE_OWNER_URL=postgres://nexus_owner:CAMBIAR@localhost:5432/nexus

# Conexión de la aplicación: rol SIN BYPASSRLS. La API solo usa esta.
DATABASE_URL=postgres://nexus_app:CAMBIAR@localhost:5432/nexus

# API
API_PORT=4000
# Orígenes permitidos para peticiones mutantes (CSRF / CORS), separados por coma.
ALLOWED_ORIGINS=http://localhost:3000
# Duración de la sesión en minutos.
SESSION_TTL_MINUTES=480
# Intentos de login por IP+correo cada 15 min (subirlo solo para pruebas E2E locales).
LOGIN_RATE_LIMIT_MAX=10

# Web
NEXUS_API_INTERNAL_URL=http://localhost:4000
